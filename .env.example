# Keys only. This file is tracked; every other .env* file is gitignored.
#
# PUBLIC IDENTIFIERS. Every NEXT_PUBLIC_ value is inlined into the client
# bundle in plain text. Only the keys named in
# scripts/lib/embedded-secrets.mjs may carry the prefix; the build refuses any
# other NEXT_PUBLIC_ key that has a value.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_THEME=generic

# SERVER-ONLY. In Vercel these are Sensitive variables entered by the owner.
# For local development they go in .env.local, which is gitignored. They are
# read only inside `server-only` modules and never spelled with NEXT_PUBLIC_.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
