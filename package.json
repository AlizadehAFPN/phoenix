{
  "name": "phoenix-site",
  "version": "0.1.0",
  "private": true,
  "description": "One-page marketing site for Phoenix, the iPad-first EFB.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "build": "node scripts/check-release-secrets.mjs && next build && node scripts/scan-build-artifacts.mjs",
    "build:docker": "BUILD_TARGET=docker npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "tokens": "node scripts/tokens/extract.mjs",
    "textures": "node scripts/textures/build.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.4.0",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
